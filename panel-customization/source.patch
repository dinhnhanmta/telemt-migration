diff --git a/web/src/people/createUserWithWeb.ts b/web/src/people/createUserWithWeb.ts
new file mode 100644
--- /dev/null
+++ b/web/src/people/createUserWithWeb.ts
@@ -0,0 +1,54 @@
+import { createUser, getTelemtReloadStatus, getTelemtWebAccess, putTelemtUserWebAccess } from "../lib/api/generated/sdk.gen";
+import type { CreateUserResponse, UserCreate, WebAccessView } from "../lib/api/generated/types.gen";
+import { apiErrorCode } from "./apiError";
+import { webProfilesForUser } from "./webAccess.helpers";
+
+export type CreatedWebUser = CreateUserResponse & { webError?: unknown };
+
+// Only the newly created user is changed. Read the current revision again after
+// creation, because creating an access user also changes the Telemt revision.
+export async function createUserWithWeb(body: UserCreate): Promise<CreatedWebUser> {
+  const signal = AbortSignal.timeout(60_000);
+  const { data: initial } = await getTelemtWebAccess({ throwOnError: true, signal });
+  if (!initial.enabled || !initial.vhosts.length) throw { code: "web_vhost_not_found" };
+  const host = initial.vhosts[0]!.host;
+  const { data: created } = await createUser({ body, throwOnError: true, signal });
+  try {
+    for (let attempt = 0; attempt < 3; attempt++) {
+      const { data: current } = await getTelemtWebAccess({ throwOnError: true, signal });
+      if (!current.enabled || !current.vhosts.some(v => v.host === host)) throw { code: "web_vhost_not_found" };
+      const profiles = profilesWithDefault(current, created.user.username, host);
+      try {
+        const { data: result } = await putTelemtUserWebAccess({
+          path: { username: created.user.username }, headers: { "If-Match": current.revision },
+          body: { profiles }, throwOnError: true, signal,
+        });
+        let reload = result.reload;
+        while (reload && reload.state !== "succeeded") {
+          if (reload.state === "failed" || reload.state === "rolled_back") throw { code: "reload_failed" };
+          await new Promise(resolve => setTimeout(resolve, 300));
+          const { data } = await getTelemtReloadStatus({ path: { id: reload.reload_id }, throwOnError: true, signal });
+          reload = data;
+        }
+        if (!reload && result.runtime_reload_required) throw { code: "reload_failed" };
+        return created;
+      } catch (error) {
+        if (apiErrorCode(error) === "revision_conflict" && attempt < 2) continue;
+        throw error;
+      }
+    }
+    throw { code: "revision_conflict" };
+  } catch (webError) {
+    // Creation already succeeded. Preserve its secret and show a recovery action;
+    // never retry POST /api/users or hide an existing account behind a create error.
+    return { ...created, webError };
+  }
+}
+
+function profilesWithDefault(view: WebAccessView, username: string, host: string) {
+  const profiles = webProfilesForUser(view, username);
+  if (!profiles.some(p => p.vhost === host && p.secret_mode === "dd")) {
+    profiles.push({ vhost: host, secret_mode: "dd" });
+  }
+  return profiles;
+}
diff --git a/web/src/people/createUserWithWeb.test.ts b/web/src/people/createUserWithWeb.test.ts
new file mode 100644
--- /dev/null
+++ b/web/src/people/createUserWithWeb.test.ts
@@ -0,0 +1,55 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createUser, getTelemtReloadStatus, getTelemtWebAccess, putTelemtUserWebAccess } from "../lib/api/generated/sdk.gen";
+import { createUserWithWeb } from "./createUserWithWeb";
+
+vi.mock("../lib/api/generated/sdk.gen", () => ({
+  createUser: vi.fn(), getTelemtReloadStatus: vi.fn(), getTelemtWebAccess: vi.fn(), putTelemtUserWebAccess: vi.fn(),
+}));
+const view = { enabled: true, revision: "before-create", vhosts: [{ host: "web.example.org", public_addr: "203.0.113.1:443", profiles: [{ user: "existing", secret_mode: "plain" as const }] }] };
+const created = { user: { username: "new-user" }, secret: "0123456789abcdef0123456789abcdef" };
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  vi.mocked(getTelemtWebAccess).mockResolvedValue({ data: view } as never);
+  vi.mocked(createUser).mockResolvedValue({ data: created } as never);
+  vi.mocked(putTelemtUserWebAccess).mockResolvedValue({ data: { revision: "after-profile", changed: ["web.vhosts"], reload: { state: "succeeded", reload_id: 1 } } } as never);
+});
+
+describe("one-step WEB user creation", () => {
+  it("keeps the submitted expiry/limits and attaches DD using the post-create revision", async () => {
+    vi.mocked(getTelemtWebAccess).mockResolvedValueOnce({ data: view } as never).mockResolvedValueOnce({ data: { ...view, revision: "after-create" } } as never);
+    const body = { username: "new-user", max_unique_ips: 2, expiration_rfc3339: "2026-12-31T23:59:59Z" };
+    expect(await createUserWithWeb(body)).toEqual(created);
+    expect(createUser).toHaveBeenCalledExactlyOnceWith(expect.objectContaining({ body }));
+    expect(putTelemtUserWebAccess).toHaveBeenCalledExactlyOnceWith(expect.objectContaining({ path: { username: "new-user" }, headers: { "If-Match": "after-create" }, body: { profiles: [{ vhost: "web.example.org", secret_mode: "dd" }] } }));
+    expect(view.vhosts[0]!.profiles).toEqual([{ user: "existing", secret_mode: "plain" }]);
+  });
+
+  it("re-reads and retries only the WEB write when another configuration edit wins", async () => {
+    vi.mocked(putTelemtUserWebAccess).mockRejectedValueOnce({ code: "revision_conflict" });
+    await createUserWithWeb({ username: "new-user" });
+    expect(createUser).toHaveBeenCalledTimes(1);
+    expect(putTelemtUserWebAccess).toHaveBeenCalledTimes(2);
+    expect(getTelemtWebAccess).toHaveBeenCalledTimes(3);
+  });
+
+  it("does not create an unusable account when WEB is disabled", async () => {
+    vi.mocked(getTelemtWebAccess).mockResolvedValue({ data: { ...view, enabled: false } } as never);
+    await expect(createUserWithWeb({ username: "new-user" })).rejects.toEqual({ code: "web_vhost_not_found" });
+    expect(createUser).not.toHaveBeenCalled();
+  });
+
+  it("preserves an already created secret on WEB failure and never repeats creation", async () => {
+    vi.mocked(putTelemtUserWebAccess).mockRejectedValue({ code: "telemt_unreachable" });
+    expect(await createUserWithWeb({ username: "new-user" })).toEqual({ ...created, webError: { code: "telemt_unreachable" } });
+    expect(createUser).toHaveBeenCalledTimes(1);
+  });
+
+  it("waits for runtime activation and reports a rolled-back reload", async () => {
+    vi.mocked(putTelemtUserWebAccess).mockResolvedValue({ data: { revision: "r2", changed: ["web.vhosts"], reload: { state: "accepted", reload_id: 7 } } } as never);
+    vi.mocked(getTelemtReloadStatus).mockResolvedValue({ data: { state: "rolled_back", reload_id: 7 } } as never);
+    const result = await createUserWithWeb({ username: "new-user" });
+    expect(result.webError).toEqual({ code: "reload_failed" });
+    expect(getTelemtReloadStatus).toHaveBeenCalledWith(expect.objectContaining({ path: { id: 7 } }));
+  });
+});
